{
  "name": "gaoq-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "predev": "pnpm --filter @gaoq/shared-types build && pnpm --filter @gaoq/shared-utils build",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "prelint": "pnpm --filter @gaoq/shared-types build && pnpm --filter @gaoq/shared-utils build && pnpm --filter @gaoq/platform-contracts build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "quality:mcp-confirmation-coverage": "pnpm --filter @gaoq/erp-api test:coverage:mcp-confirmation",
    "quality:payroll-shadow-coverage": "pnpm --filter @gaoq/erp-api test:coverage:payroll-shadow",
    "quality:payroll-run-coverage": "pnpm --filter @gaoq/erp-api test:coverage:payroll-run",
    "quality:payroll-approval-coverage": "pnpm --filter @gaoq/erp-api test:coverage:payroll-approval",
    "quality:care-occasion-application-coverage": "pnpm --filter @gaoq/erp-api test:coverage:care-occasion-application",
    "quality:data-migration-coverage": "pnpm --filter @gaoq/erp-api test:coverage:data-migration",
    "quality:attendance-application-coverage": "pnpm --filter @gaoq/erp-api test:coverage:attendance-application",
    "quality:recruitment-offer-coverage": "pnpm --filter @gaoq/erp-api test:coverage:recruitment-offer",
    "quality:approval-crypto-coverage": "pnpm --filter @gaoq/erp-api test:coverage:approval-crypto",
    "quality:tenant-context-coverage": "pnpm --filter @gaoq/erp-api test:coverage:tenant-context",
    "quality:care-repositories-coverage": "pnpm --filter @gaoq/erp-api test:coverage:care-repositories",
    "quality:org-repositories-coverage": "pnpm --filter @gaoq/erp-api test:coverage:org-repositories",
    "quality:recruitment-repositories-coverage": "pnpm --filter @gaoq/erp-api test:coverage:recruitment-repositories",
    "quality:knowledge-repositories-coverage": "pnpm --filter @gaoq/erp-api test:coverage:knowledge-repositories",
    "quality:marketing-cms-service-coverage": "pnpm --filter @gaoq/erp-api test:coverage:marketing-cms-service",
    "quality:approval-repositories-coverage": "pnpm --filter @gaoq/erp-api test:coverage:approval-repositories",
    "quality:approval-application-coverage": "pnpm --filter @gaoq/erp-api test:coverage:approval-application",
    "quality:authorization-coverage": "pnpm --filter @gaoq/erp-api test:coverage:authorization",
    "security:licenses": "pnpm licenses list --prod --json | node scripts/validate-dependency-licenses.mjs",
    "security:containers": "node scripts/validate-container-images.mjs",
    "website:production:self-test": "node scripts/validate-website-production-build.mjs",
    "deployment:local-runtime:validate": "node scripts/validate-mongo-init.mjs && node scripts/validate-worker-runtime.mjs",
    "deployment:kubernetes:validate": "node scripts/validate-kubernetes-deployment.mjs",
    "deployment:kubernetes:guardrails:validate": "node scripts/validate-kubernetes-platform-guardrails.mjs",
    "security:validate": "node scripts/validate-security-workflow.mjs",
    "security:dast:run": "node scripts/security/run-phase-5-dast.mjs --run",
    "security:dast:self-test": "node scripts/security/run-phase-5-dast.mjs --self-test && node scripts/security/validate-phase-5-dast-evidence.mjs --self-test",
    "security:dast:validate-evidence": "node scripts/security/validate-phase-5-dast-evidence.mjs",
    "performance:validate": "node scripts/performance/validate-phase-5-capacity.mjs",
    "performance:self-test": "node scripts/performance/validate-phase-5-capacity.mjs --self-test",
    "migration:rehearsal:validate-evidence": "node scripts/migration/validate-phase-5-migration-rehearsal-evidence.mjs",
    "migration:rehearsal:self-test": "node scripts/migration/validate-phase-5-migration-rehearsal-evidence.mjs --self-test",
    "migration:rehearsal:print-contract": "node scripts/migration/validate-phase-5-migration-rehearsal-evidence.mjs --print-contract",
    "resilience:validate-evidence": "node scripts/resilience/validate-phase-5-resilience-evidence.mjs",
    "resilience:self-test": "node scripts/resilience/validate-phase-5-resilience-evidence.mjs --self-test",
    "release:go-no-go:validate-evidence": "node scripts/release/validate-phase-5-go-no-go-evidence.mjs",
    "release:go-no-go:self-test": "node scripts/release/validate-phase-5-go-no-go-evidence.mjs --self-test",
    "release:readiness:validate-evidence": "node scripts/release/validate-phase-5-readiness-evidence.mjs",
    "release:readiness:self-test": "node scripts/release/validate-phase-5-readiness-evidence.mjs --self-test",
    "release:readiness:print-contract": "node scripts/release/validate-phase-5-readiness-evidence.mjs --print-contract",
    "mcp:catalog:print": "node scripts/mcp/validate-phase-5-mcp-catalog.mjs --print",
    "mcp:catalog:self-test": "node scripts/mcp/validate-phase-5-mcp-catalog.mjs --self-test",
    "mcp:integration:validate-evidence": "node scripts/mcp/validate-phase-5-mcp-integration-evidence.mjs",
    "mcp:integration:self-test": "node scripts/mcp/validate-phase-5-mcp-integration-evidence.mjs --self-test",
    "release:phase6:cutover:validate-evidence": "node scripts/release/validate-phase-6-cutover-evidence.mjs",
    "release:phase6:cutover:self-test": "node scripts/release/validate-phase-6-cutover-evidence.mjs --self-test",
    "release:phase6:hypercare:validate-evidence": "node scripts/release/validate-phase-6-hypercare-evidence.mjs",
    "release:phase6:hypercare:self-test": "node scripts/release/validate-phase-6-hypercare-evidence.mjs --self-test",
    "release:phase6:deployment:validate-plan": "node scripts/release/validate-phase-6-deployment-plan.mjs",
    "release:phase6:deployment:self-test": "node scripts/release/validate-phase-6-deployment-plan.mjs --self-test",
    "release:phase6:platform-intake:validate-evidence": "node scripts/release/validate-phase-6-platform-intake.mjs",
    "release:phase6:platform-intake:self-test": "node scripts/release/validate-phase-6-platform-intake.mjs --self-test",
    "release:phase6:platform-intake:print-contract": "node scripts/release/validate-phase-6-platform-intake.mjs --print-contract",
    "release:phase6:workflows:validate": "node scripts/validate-phase-6-workflows.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm quality:mcp-confirmation-coverage && pnpm quality:payroll-shadow-coverage && pnpm quality:payroll-run-coverage && pnpm quality:payroll-approval-coverage && pnpm quality:care-occasion-application-coverage && pnpm quality:data-migration-coverage && pnpm quality:attendance-application-coverage && pnpm quality:recruitment-offer-coverage && pnpm quality:approval-crypto-coverage && pnpm quality:tenant-context-coverage && pnpm quality:care-repositories-coverage && pnpm quality:org-repositories-coverage && pnpm quality:recruitment-repositories-coverage && pnpm quality:knowledge-repositories-coverage && pnpm quality:marketing-cms-service-coverage && pnpm quality:approval-repositories-coverage && pnpm quality:approval-application-coverage && pnpm quality:authorization-coverage && node scripts/validate-docs.mjs && pnpm security:validate && pnpm security:containers && pnpm website:production:self-test && pnpm deployment:local-runtime:validate && pnpm deployment:kubernetes:validate && pnpm deployment:kubernetes:guardrails:validate && pnpm security:dast:self-test && pnpm performance:self-test && pnpm migration:rehearsal:self-test && pnpm resilience:self-test && pnpm release:readiness:self-test && pnpm release:go-no-go:self-test && pnpm mcp:catalog:self-test && pnpm mcp:integration:self-test && pnpm release:phase6:cutover:self-test && pnpm release:phase6:hypercare:self-test && pnpm release:phase6:deployment:self-test && pnpm release:phase6:platform-intake:self-test && pnpm release:phase6:workflows:validate"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.10",
      "brace-expansion": "5.0.8",
      "postcss": "8.5.18",
      "sharp": "0.35.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
