# 启用前必须替换证书路径，并先执行 nginx -t。该文件只代理 GaoQ-OS 独立回环端口。
server {
    listen 80;
    server_name aio.gaoq.com;
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme-challenge; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name aio.gaoq.com;
    ssl_certificate /etc/nginx/ssl/aio.gaoq.com.pem;
    ssl_certificate_key /etc/nginx/ssl/aio.gaoq.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location /api/ { proxy_pass http://127.0.0.1:3201; include /etc/nginx/gaoq-ai-proxy-headers.conf; }
    location = /mcp { proxy_pass http://127.0.0.1:3201; include /etc/nginx/gaoq-ai-proxy-headers.conf; }
    location /.well-known/ { proxy_pass http://127.0.0.1:3201; include /etc/nginx/gaoq-ai-proxy-headers.conf; }
    # 专业算薪不使用独立域名，统一挂载在 aio.gaoq.com 路径下（更长前缀优先匹配）。
    location = /.well-known/oauth-protected-resource/api/payroll/v1 { proxy_pass http://127.0.0.1:3211; include /etc/nginx/gaoq-ai-proxy-headers.conf; }
    location /api/payroll/ { proxy_pass http://127.0.0.1:3211; include /etc/nginx/gaoq-ai-proxy-headers.conf; }
    location = /payroll { proxy_pass http://127.0.0.1:3210; include /etc/nginx/gaoq-ai-proxy-headers.conf; }
    location /payroll/ { proxy_pass http://127.0.0.1:3210; include /etc/nginx/gaoq-ai-proxy-headers.conf; }
    location / { proxy_pass http://127.0.0.1:3200; include /etc/nginx/gaoq-ai-proxy-headers.conf; }
}

server {
    listen 80;
    server_name recruit.gaoq.com;
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme-challenge; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name recruit.gaoq.com;
    ssl_certificate /etc/nginx/ssl/recruit.gaoq.com.pem;
    ssl_certificate_key /etc/nginx/ssl/recruit.gaoq.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = / { return 302 /careers; }
    location /careers { proxy_pass http://127.0.0.1:3200; include /etc/nginx/gaoq-ai-proxy-headers.conf; }
    location /api/careers/ { proxy_pass http://127.0.0.1:3200; include /etc/nginx/gaoq-ai-proxy-headers.conf; }
    location /_next/ { proxy_pass http://127.0.0.1:3200; include /etc/nginx/gaoq-ai-proxy-headers.conf; }
    location / { return 404; }
}

# 招聘门户新增域名 joinus.gaoq.com，与 recruit.gaoq.com 共用同一组受限路由。
server {
    listen 80;
    server_name joinus.gaoq.com;
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme-challenge; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name joinus.gaoq.com;
    ssl_certificate /etc/nginx/ssl/joinus.gaoq.com.pem;
    ssl_certificate_key /etc/nginx/ssl/joinus.gaoq.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = / { return 302 /careers; }
    location /careers { proxy_pass http://127.0.0.1:3200; include /etc/nginx/gaoq-ai-proxy-headers.conf; }
    location /api/careers/ { proxy_pass http://127.0.0.1:3200; include /etc/nginx/gaoq-ai-proxy-headers.conf; }
    location /_next/ { proxy_pass http://127.0.0.1:3200; include /etc/nginx/gaoq-ai-proxy-headers.conf; }
    location / { return 404; }
}

server {
    listen 80;
    server_name gaoq.com;
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme-challenge; }
    location / { return 301 https://www.gaoq.com$request_uri; }
}

server {
    listen 443 ssl;
    server_name gaoq.com;
    ssl_certificate /etc/nginx/ssl/gaoq.com.pem;
    ssl_certificate_key /etc/nginx/ssl/gaoq.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / { return 301 https://www.gaoq.com$request_uri; }
}

server {
    listen 80;
    server_name www.gaoq.com;
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme-challenge; }
    location / { return 301 https://www.gaoq.com$request_uri; }
}

server {
    listen 443 ssl;
    server_name www.gaoq.com;
    ssl_certificate /etc/nginx/ssl/www.gaoq.com.pem;
    ssl_certificate_key /etc/nginx/ssl/www.gaoq.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /system-status.html {
        alias /var/www/gaoq-system-status/system-status.html;
        default_type text/html;
        add_header Cache-Control "public, max-age=300" always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }
    location / { proxy_pass http://127.0.0.1:3202; include /etc/nginx/gaoq-ai-proxy-headers.conf; }
}
