# 仅用于首次签发证书；不得代理应用，也不得包含现有项目域名。
server {
    listen 80;
    server_name aio.gaoq.com joinus.gaoq.com www.gaoq.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme-challenge;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 503;
    }
}
