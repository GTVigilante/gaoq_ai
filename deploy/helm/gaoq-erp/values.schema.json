{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "nameOverride",
    "fullnameOverride",
    "targetNamespace",
    "release",
    "images",
    "runtime",
    "serviceAccount",
    "replicas",
    "resources",
    "autoscaling",
    "podDisruptionBudget",
    "ingress",
    "networkPolicy",
    "nodeSelector",
    "tolerations",
    "topologySpreadKey"
  ],
  "properties": {
    "nameOverride": { "$ref": "#/definitions/optionalDnsLabel" },
    "fullnameOverride": { "$ref": "#/definitions/optionalDnsLabel" },
    "targetNamespace": { "$ref": "#/definitions/dnsLabel" },
    "release": {
      "type": "object",
      "required": ["commitSha", "deploymentManifestHash", "rolloutId"],
      "properties": {
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "deploymentManifestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "rolloutId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" }
      },
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "required": ["api", "worker", "web", "website", "pullPolicy", "pullSecrets"],
      "properties": {
        "api": { "$ref": "#/definitions/image" },
        "worker": { "$ref": "#/definitions/image" },
        "web": { "$ref": "#/definitions/image" },
        "website": { "$ref": "#/definitions/image" },
        "pullPolicy": { "enum": ["IfNotPresent", "Never"] },
        "pullSecrets": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["apiConfigMapName", "apiSecretName", "workerConfigMapName", "workerSecretName", "webConfigMapName", "webSecretName", "websiteConfigMapName", "websiteSecretName"],
      "properties": {
        "apiConfigMapName": { "$ref": "#/definitions/dnsLabel" },
        "apiSecretName": { "$ref": "#/definitions/dnsLabel" },
        "workerConfigMapName": { "$ref": "#/definitions/dnsLabel" },
        "workerSecretName": { "$ref": "#/definitions/dnsLabel" },
        "webConfigMapName": { "$ref": "#/definitions/dnsLabel" },
        "webSecretName": { "$ref": "#/definitions/dnsLabel" },
        "websiteConfigMapName": { "$ref": "#/definitions/dnsLabel" },
        "websiteSecretName": { "$ref": "#/definitions/dnsLabel" }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/definitions/dnsLabel" }
      },
      "additionalProperties": false
    },
    "replicas": {
      "type": "object",
      "required": ["api", "worker", "web", "website"],
      "properties": {
        "api": { "type": "integer", "minimum": 3, "maximum": 50 },
        "worker": { "type": "integer", "minimum": 2, "maximum": 50 },
        "web": { "type": "integer", "minimum": 3, "maximum": 50 },
        "website": { "type": "integer", "minimum": 3, "maximum": 50 }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["api", "worker", "web", "website"],
      "properties": {
        "api": { "$ref": "#/definitions/componentResources" },
        "worker": { "$ref": "#/definitions/componentResources" },
        "web": { "$ref": "#/definitions/componentResources" },
        "website": { "$ref": "#/definitions/componentResources" }
      },
      "additionalProperties": false
    },
    "autoscaling": {
      "type": "object",
      "required": ["api", "web", "website"],
      "properties": {
        "api": { "$ref": "#/definitions/autoscaling" },
        "web": { "$ref": "#/definitions/autoscaling" },
        "website": { "$ref": "#/definitions/autoscaling" }
      },
      "additionalProperties": false
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["apiMinAvailable", "workerMinAvailable", "webMinAvailable", "websiteMinAvailable"],
      "properties": {
        "apiMinAvailable": { "type": "integer", "minimum": 2, "maximum": 49 },
        "workerMinAvailable": { "type": "integer", "minimum": 1, "maximum": 49 },
        "webMinAvailable": { "type": "integer", "minimum": 2, "maximum": 49 },
        "websiteMinAvailable": { "type": "integer", "minimum": 2, "maximum": 49 }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "annotations", "apiHost", "webHost", "websiteHost", "tlsSecretName", "apiPath", "webPath", "websitePath"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "$ref": "#/definitions/optionalDnsLabel" },
        "annotations": { "$ref": "#/definitions/annotations" },
        "apiHost": { "$ref": "#/definitions/optionalHostname" },
        "webHost": { "$ref": "#/definitions/optionalHostname" },
        "websiteHost": { "$ref": "#/definitions/optionalHostname" },
        "tlsSecretName": { "$ref": "#/definitions/optionalDnsLabel" },
        "apiPath": { "$ref": "#/definitions/httpPath" },
        "webPath": { "$ref": "#/definitions/httpPath" },
        "websitePath": { "$ref": "#/definitions/httpPath" }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "ingressNamespaceLabels",
        "ingressPodLabels",
        "monitoringNamespaceLabels",
        "monitoringPodLabels",
        "dnsNamespaceLabels",
        "dnsPodLabels",
        "httpsEgressCidrs",
        "mongodbCidrs",
        "redisCidrs"
      ],
      "properties": {
        "ingressNamespaceLabels": { "$ref": "#/definitions/nonEmptyLabels" },
        "ingressPodLabels": { "$ref": "#/definitions/nonEmptyLabels" },
        "monitoringNamespaceLabels": { "$ref": "#/definitions/nonEmptyLabels" },
        "monitoringPodLabels": { "$ref": "#/definitions/nonEmptyLabels" },
        "dnsNamespaceLabels": { "$ref": "#/definitions/nonEmptyLabels" },
        "dnsPodLabels": { "$ref": "#/definitions/nonEmptyLabels" },
        "httpsEgressCidrs": { "$ref": "#/definitions/privateCidrs" },
        "mongodbCidrs": { "$ref": "#/definitions/privateCidrs" },
        "redisCidrs": { "$ref": "#/definitions/privateCidrs" }
      },
      "additionalProperties": false
    },
    "nodeSelector": { "$ref": "#/definitions/labels" },
    "tolerations": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/definitions/toleration" }
    },
    "topologySpreadKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9./_-]+$"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 3, "maxLength": 255, "not": { "pattern": "@|:latest$" } },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "optionalDnsLabel": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "optionalHostname": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^(?:[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "httpPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^/[A-Za-z0-9/_-]*$"
    },
    "annotations": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[A-Za-z0-9./_-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024,
        "pattern": "^[^\\r\\n]*$"
      }
    },
    "labels": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[A-Za-z0-9./_-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "resourceList": {
      "type": "object",
      "required": ["cpu", "memory", "ephemeral-storage"],
      "properties": {
        "cpu": { "$ref": "#/definitions/resourceQuantity" },
        "memory": { "$ref": "#/definitions/resourceQuantity" },
        "ephemeral-storage": { "$ref": "#/definitions/resourceQuantity" }
      },
      "additionalProperties": false
    },
    "resourceQuantity": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:m|Ki|Mi|Gi|Ti|Pi|Ei)?$"
    },
    "componentResources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resourceList" },
        "limits": { "$ref": "#/definitions/resourceList" }
      },
      "additionalProperties": false
    },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas", "cpuUtilization", "memoryUtilization"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 3, "maximum": 50 },
        "maxReplicas": { "type": "integer", "minimum": 3, "maximum": 100 },
        "cpuUtilization": { "type": "integer", "minimum": 20, "maximum": 90 },
        "memoryUtilization": { "type": "integer", "minimum": 20, "maximum": 90 }
      },
      "additionalProperties": false
    },
    "toleration": {
      "type": "object",
      "required": ["operator"],
      "properties": {
        "key": { "type": "string", "maxLength": 253, "pattern": "^[A-Za-z0-9./_-]*$" },
        "operator": { "enum": ["Exists", "Equal"] },
        "value": { "type": "string", "maxLength": 63, "pattern": "^[A-Za-z0-9._-]*$" },
        "effect": { "enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"] },
        "tolerationSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 }
      },
      "additionalProperties": false
    },
    "nonEmptyLabels": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 12,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63
      }
    },
    "privateCidrs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(10\\.(?:[0-9]{1,3}\\.){2}[0-9]{1,3}/(?:[8-9]|[12][0-9]|3[0-2])|172\\.(?:1[6-9]|2[0-9]|3[01])\\.(?:[0-9]{1,3})\\.[0-9]{1,3}/(?:1[2-9]|2[0-9]|3[0-2])|192\\.168\\.(?:[0-9]{1,3})\\.[0-9]{1,3}/(?:1[6-9]|2[0-9]|3[0-2]))$"
      }
    }
  }
}
