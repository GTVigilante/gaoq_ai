NODE_ENV=development
PORT=3001
WORKER_METRICS_PORT=9464
MONGODB_URI=mongodb://localhost:27017/gaoq_os?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:3000
# 公共官网跨域来源与服务端固定站点映射；客户端不得传入 tenantId
MARKETING_WEBSITE_ORIGIN=http://localhost:3002
MARKETING_PUBLIC_TENANT_ID=tenant-marketing
MARKETING_PUBLIC_SITE_ID=gaoq
# 营销联系人 AES-256-GCM 与盲索引使用两个独立 32 字节 Base64URL Secret
MARKETING_LEAD_ENCRYPTION_KEY_BASE64=
MARKETING_LEAD_BLIND_INDEX_KEY_BASE64=
MARKETING_MEDIA_GATEWAY_ENDPOINT=
MARKETING_MEDIA_GATEWAY_BEARER_TOKEN=
MARKETING_AI_GATEWAY_ENDPOINT=
MARKETING_AI_GATEWAY_BEARER_TOKEN=
MARKETING_CAPTCHA_VERIFY_ENDPOINT=
MARKETING_CAPTCHA_BEARER_TOKEN=
MARKETING_NOTIFICATION_GATEWAY_ENDPOINT=
MARKETING_NOTIFICATION_GATEWAY_BEARER_TOKEN=
LOG_LEVEL=info
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=gaoq-erp
AUTH_RESOURCE=http://localhost:3001/mcp
# 独立业务系统使用不同 resource/audience；此处只登记公开标识，不包含凭据
AUTH_ADDITIONAL_RESOURCES_JSON=[{"resource":"http://localhost:3101/api","audience":"gaoq-payroll-api"}]
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json
PAYROLL_SYSTEM_MODE=external
PAYROLL_WEB_ORIGIN=http://localhost:3100
# 仅由 KMS/Secret Manager 注入；仓库和镜像中必须保持为空
AUTH_SIGNING_PRIVATE_KEY_BASE64=
AUTH_SIGNING_KEY_ID=
# 仅由 KMS/Secret Manager 注入 HMAC-SHA-256 密钥环 JSON；仓库和镜像中必须保持为空
AUDIT_INTEGRITY_KEYS=
# 审批表单专用 AES-256-GCM 密钥环 JSON；不得与审计或开户密钥复用
APPROVAL_DATA_ENCRYPTION_KEYS=
# 招聘 L3/L4 数据与精确去重 HMAC 必须使用两个独立密钥域
RECRUITMENT_DATA_ENCRYPTION_KEYS=
RECRUITMENT_BLIND_INDEX_KEYS=
# Person 生日月日独立 HMAC 密钥环；禁止与招聘、考勤或资金密钥复用
ORG_PERSON_BIRTHDAY_BLIND_INDEX_KEYS=
# 关怀策略与通知签名网关均由服务端控制面/Secret Manager 注入
CARE_OCCASION_POLICIES_JSON=[]
CARE_OCCASION_NOTIFICATION_ENDPOINT=
CARE_OCCASION_NOTIFICATION_BEARER_TOKEN=
CARE_OCCASION_NOTIFICATION_SIGNING_PUBLIC_KEY_BASE64=
CARE_OCCASION_NOTIFICATION_SIGNING_KEY_ID=
# 简历隔离网关负责归属校验、恶意文件扫描、文本提取与 PII 去除
RECRUITMENT_RESUME_SOURCE_ENDPOINT=
RECRUITMENT_RESUME_SOURCE_BEARER_TOKEN=
# 默认关闭；启用 openai 时下列模型与独立 API Key 必须成套由 Secret Manager 注入
RECRUITMENT_RESUME_AI_PROVIDER=disabled
KNOWLEDGE_EVIDENCE_GATEWAY_ENDPOINT=
KNOWLEDGE_EVIDENCE_GATEWAY_BEARER_TOKEN=
KNOWLEDGE_EVIDENCE_GATEWAY_SIGNING_PUBLIC_KEY_BASE64=
KNOWLEDGE_EVIDENCE_GATEWAY_SIGNING_KEY_ID=
KNOWLEDGE_SEARCH_GATEWAY_ENDPOINT=
KNOWLEDGE_SEARCH_GATEWAY_BEARER_TOKEN=
KNOWLEDGE_SEARCH_GATEWAY_SIGNING_PUBLIC_KEY_BASE64=
KNOWLEDGE_SEARCH_GATEWAY_SIGNING_KEY_ID=
OPENAI_RESUME_MODEL=
OPENAI_RESUME_API_KEY=
# 考勤 L4 明细与外部事件盲指纹使用两个独立密钥域
ATTENDANCE_DATA_ENCRYPTION_KEYS=
ATTENDANCE_BLIND_INDEX_KEYS=
# 薪酬 L4 输入、计算步骤与结果专用 AES-256-GCM 密钥环
PAYROLL_DATA_ENCRYPTION_KEYS=
PAYROLL_TAX_WORM_ARCHIVE_ENDPOINT=
PAYROLL_TAX_WORM_ARCHIVE_BEARER_TOKEN=
PAYROLL_TAX_WORM_RETENTION_DAYS=3650
PAYROLL_TAX_GATEWAY_ENDPOINT=
PAYROLL_TAX_GATEWAY_BEARER_TOKEN=
PAYROLL_TAX_GATEWAY_MODE=sandbox
# 资金 L4 数据与银行账号精确匹配使用两个独立密钥域
TREASURY_DATA_ENCRYPTION_KEYS=
TREASURY_BLIND_INDEX_KEYS=
TREASURY_WORM_ARCHIVE_ENDPOINT=
TREASURY_WORM_ARCHIVE_BEARER_TOKEN=
TREASURY_WORM_RETENTION_DAYS=3650
TREASURY_BANK_SUBMISSION_ENDPOINT=
TREASURY_BANK_SUBMISSION_BEARER_TOKEN=
TREASURY_BANK_SUBMISSION_MODE=sandbox
# Phase 6 生产执行授权域；sandbox 必须留空，生产值仅由发布平台与 Secret Manager 注入。
PHASE6_PRODUCTION_AUTHORIZATION_ENDPOINT=
PHASE6_PRODUCTION_AUTHORIZATION_BEARER_TOKEN=
PHASE6_RELEASE_COMMIT_SHA=
PHASE6_DEPLOYMENT_MANIFEST_SHA256=
TREASURY_BANK_RETURN_INBOX_ENDPOINT=
TREASURY_BANK_RETURN_INBOX_BEARER_TOKEN=
# eSign 回调原文与外部流程标识专用 AES-256-GCM 密钥环
ESIGN_WEBHOOK_ENCRYPTION_KEYS=
ESIGN_API_BASE_URL=https://smlopenapi.esign.cn
ESIGN_MALWARE_SCAN_ENDPOINT=
ESIGN_MALWARE_SCAN_BEARER_TOKEN=
ESIGN_WORM_ARCHIVE_ENDPOINT=
ESIGN_WORM_ARCHIVE_BEARER_TOKEN=
ESIGN_WORM_RETENTION_DAYS=3650
# 每个 eSign appId 单独配置；实际名称必须与绑定记录 credentialSecretRef 一致
GAOQ_ESIGN_APP_EXAMPLE=
# OP 经营摘要原始请求专用 AES-256-GCM 密钥环
OP_WEBHOOK_ENCRYPTION_KEYS=
# OP 审批原始表单专用 AES-256-GCM 密钥环，不得与经营摘要复用
OP_APPROVAL_WEBHOOK_ENCRYPTION_KEYS=
# 每个 OP clientId 单独配置；实际名称必须与绑定记录 credentialSecretRef 一致
GAOQ_OP_HMAC_EXAMPLE=
# ERP→OP 组织下发独立 HTTPS API 根地址；不得与 ERP 同源
OP_API_BASE_URL=
# OP 出站服务账号凭据 JSON（clientId/clientSecret），与入站 GAOQ_OP_HMAC_* 分离
GAOQ_ORG_PLATFORM_OP_EXAMPLE=
# OP 浏览器 SSO 独立 OAuth 客户端；不得复用组织下发或入站 HMAC 凭据
OP_SSO_CLIENT_ID=
OP_SSO_CLIENT_SECRET=
OP_SSO_REDIRECT_URI=
# Prometheus 独立抓取凭据；仅由 Secret Manager 注入，至少 32 个可打印 ASCII 字符
METRICS_BEARER_TOKEN=
# 独立权限域 WORM 平台；本地可留空，生产环境必须完整配置且端点必须使用 HTTPS
AUDIT_WORM_ENDPOINT=
AUDIT_WORM_BEARER_TOKEN=
# 审计锚点专用 Ed25519 PKCS#8 私钥（Base64）与 key id，禁止复用 OAuth 签名密钥
AUDIT_ANCHOR_SIGNING_PRIVATE_KEY_BASE64=
AUDIT_ANCHOR_SIGNING_KEY_ID=
AUDIT_WORM_RETENTION_DAYS=2555
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_AUTHORIZATION_SERVER=http://localhost:3001
MCP_ALLOWED_ORIGINS=http://localhost:3000
MCP_OAUTH_CLIENTS_JSON=[]
MCP_SERVICE_CLIENTS_JSON=[]
# 两类客户端都必须显式包含 allowedResources；全局注册不会隐式授权。
# 公共客户端示例：{"allowedResources":["http://localhost:3001/mcp"],"allowedScopes":[...]}
# 服务客户端示例：{"allowedResources":["http://localhost:3001/mcp"],"allowedScopes":[...]}
NEXT_PUBLIC_ERP_API_ORIGIN=http://localhost:3001
NEXT_PUBLIC_WEBSITE_ORIGIN=http://localhost:3002
NEXT_PUBLIC_MARKETING_CAPTCHA_WIDGET_ORIGIN=http://localhost:3200
NEXT_PUBLIC_MARKETING_CAPTCHA_WIDGET_URL=
ERP_API_INTERNAL_ORIGIN=http://localhost:3001
MARKETING_REVALIDATE_SECRET=
# 招聘门户 BFF 专用服务身份；客户端明文只由 Web Secret 注入，API 注册表仅保存其 SHA-256
# 生产使用 API Service 完整集群域名：http://<service>.<namespace>.svc.cluster.local:3001
ERP_API_ORIGIN=http://localhost:3001
ERP_PORTAL_OAUTH_RESOURCE=http://localhost:3001/mcp
ERP_PORTAL_CLIENT_ID=
ERP_PORTAL_CLIENT_SECRET=
CAREERS_PUBLIC_ORIGIN=http://localhost:3000
CAREERS_RATE_LIMIT_REDIS_URL=redis://localhost:6379/3
# 生产入口必须删除客户端同名头后注入此独立 Secret；不得复用 OAuth 或 Redis 密码。
CAREERS_EDGE_VERIFICATION_SECRET=
# 仅允许 x-real-ip、cf-connecting-ip 或 true-client-ip。
CAREERS_CLIENT_IP_HEADER=x-real-ip
# H5 允许被嵌入的平台精确 HTTPS Origin，空格分隔、最多 10 个；留空时仅允许同源
ERP_MOBILE_FRAME_ANCESTORS=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=http://localhost:3000/auth/callback/dingtalk
FEISHU_CLIENT_ID=
FEISHU_CLIENT_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3000/auth/callback/feishu
# 仅由 KMS/Secret Manager 注入 AES-256 密钥环 JSON；仓库和镜像中必须保持为空
GAOQ_ORG_PROVISIONING_ENCRYPTION_KEYS=
