NODE_ENV=development
PORT=3001
WORKER_METRICS_PORT=9464
MONGODB_URI=mongodb://localhost:27017/gaoq_os?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=gaoq-erp
AUTH_RESOURCE=http://localhost:3001/mcp
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json
# 仅由 KMS/Secret Manager 注入；仓库和镜像中必须保持为空
AUTH_SIGNING_PRIVATE_KEY_BASE64=
AUTH_SIGNING_KEY_ID=
# 仅由 KMS/Secret Manager 注入 HMAC-SHA-256 密钥环 JSON；仓库和镜像中必须保持为空
AUDIT_INTEGRITY_KEYS=
# 审批表单专用 AES-256-GCM 密钥环 JSON；不得与审计或开户密钥复用
APPROVAL_DATA_ENCRYPTION_KEYS=
# 招聘 L3/L4 数据与精确去重 HMAC 必须使用两个独立密钥域
RECRUITMENT_DATA_ENCRYPTION_KEYS=
RECRUITMENT_BLIND_INDEX_KEYS=
# 考勤 L4 明细与外部事件盲指纹使用两个独立密钥域
ATTENDANCE_DATA_ENCRYPTION_KEYS=
ATTENDANCE_BLIND_INDEX_KEYS=
# 薪酬 L4 输入、计算步骤与结果专用 AES-256-GCM 密钥环
PAYROLL_DATA_ENCRYPTION_KEYS=
# 资金 L4 数据与银行账号精确匹配使用两个独立密钥域
TREASURY_DATA_ENCRYPTION_KEYS=
TREASURY_BLIND_INDEX_KEYS=
TREASURY_WORM_ARCHIVE_ENDPOINT=
TREASURY_WORM_ARCHIVE_BEARER_TOKEN=
TREASURY_WORM_RETENTION_DAYS=3650
TREASURY_BANK_SUBMISSION_ENDPOINT=
TREASURY_BANK_SUBMISSION_BEARER_TOKEN=
# eSign 回调原文与外部流程标识专用 AES-256-GCM 密钥环
ESIGN_WEBHOOK_ENCRYPTION_KEYS=
ESIGN_API_BASE_URL=https://smlopenapi.esign.cn
ESIGN_MALWARE_SCAN_ENDPOINT=
ESIGN_MALWARE_SCAN_BEARER_TOKEN=
ESIGN_WORM_ARCHIVE_ENDPOINT=
ESIGN_WORM_ARCHIVE_BEARER_TOKEN=
ESIGN_WORM_RETENTION_DAYS=3650
# 每个 eSign appId 单独配置；实际名称必须与绑定记录 credentialSecretRef 一致
GAOQ_ESIGN_APP_EXAMPLE=
# Prometheus 独立抓取凭据；仅由 Secret Manager 注入，至少 32 个可打印 ASCII 字符
METRICS_BEARER_TOKEN=
# 独立权限域 WORM 平台；本地可留空，生产环境必须完整配置且端点必须使用 HTTPS
AUDIT_WORM_ENDPOINT=
AUDIT_WORM_BEARER_TOKEN=
# 审计锚点专用 Ed25519 PKCS#8 私钥（Base64）与 key id，禁止复用 OAuth 签名密钥
AUDIT_ANCHOR_SIGNING_PRIVATE_KEY_BASE64=
AUDIT_ANCHOR_SIGNING_KEY_ID=
AUDIT_WORM_RETENTION_DAYS=2555
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_AUTHORIZATION_SERVER=http://localhost:3001
MCP_ALLOWED_ORIGINS=http://localhost:3000
MCP_OAUTH_CLIENTS_JSON=[]
MCP_SERVICE_CLIENTS_JSON=[]
NEXT_PUBLIC_ERP_API_ORIGIN=http://localhost:3001
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=http://localhost:3000/auth/callback/dingtalk
FEISHU_CLIENT_ID=
FEISHU_CLIENT_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3000/auth/callback/feishu
# 仅由 KMS/Secret Manager 注入 AES-256 密钥环 JSON；仓库和镜像中必须保持为空
GAOQ_ORG_PROVISIONING_ENCRYPTION_KEYS=
