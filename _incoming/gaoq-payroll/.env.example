NODE_ENV=development
PORT=3101
MONGODB_URI=mongodb://localhost:27018/gaoq_payroll?replicaSet=payroll-rs0&directConnection=true
WEB_ORIGIN=http://localhost:3100

# GaoQ 统一身份服务公开配置；私钥只存在于 GaoQ 身份服务
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=gaoq-payroll-api
AUTH_RESOURCE=http://localhost:3101/api
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json
MCP_ALLOWED_ORIGINS=http://localhost:3100

# L4 薪酬数据与员工盲索引使用两个独立密钥环，仅由 Secret Manager 注入
PAYROLL_DATA_ENCRYPTION_KEYS=
PAYROLL_BLIND_INDEX_KEYS=

# Web OAuth 2.1 Authorization Code + PKCE 公共客户端
GAOQ_AUTHORIZATION_ENDPOINT=http://localhost:3001/api/auth/oauth/authorize
GAOQ_TOKEN_ENDPOINT=http://localhost:3001/api/auth/oauth/token
GAOQ_PAYROLL_CLIENT_ID=payroll-web-local
GAOQ_PAYROLL_REDIRECT_URI=http://localhost:3100/api/auth/callback

# Worker 使用同一机密客户端分别申请 ERP 和算薪资源令牌
GAOQ_OAUTH_TOKEN_URL=http://localhost:3001/api/auth/oauth/token
GAOQ_SYNC_CLIENT_ID=
GAOQ_SYNC_CLIENT_SECRET=
GAOQ_ERP_RESOURCE=http://localhost:3001/api
GAOQ_PAYROLL_RESOURCE=http://localhost:3101/api
GAOQ_ERP_API_URL=http://localhost:3001
PAYROLL_API_URL=http://localhost:3101
MASTER_DATA_SYNC_ENABLED=false
MASTER_DATA_SYNC_INTERVAL_MS=300000

REDIS_URL=redis://localhost:6381/0
