{
  "name": "gaoq-payroll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:contracts": "pnpm --filter @gaoq/shared-types build && pnpm --filter @gaoq/platform-contracts build && pnpm --filter @gaoq/payroll-core build",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "prelint": "pnpm build:contracts",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "deployment:production:validate": "node scripts/validate-production-deployment.mjs",
    "deployment:production:set-images": "node scripts/set-production-image-digests.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.10",
      "brace-expansion": "5.0.9",
      "fast-uri": "3.1.5",
      "hono": "4.12.34",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.17",
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}
